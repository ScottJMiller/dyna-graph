# DynaGraph: copy to .env on Node 1 and edit for your private LAN.
# The addresses below are examples; replace them with your nodes' addresses.
# Reserve stable node addresses in your router/DHCP configuration.
# COORDINATOR_HOST describes Node 1; it does not change Ollama's bind address.
COORDINATOR_HOST=192.168.1.10
NODE1_OLLAMA_URL=http://localhost:11434
NODE2_OLLAMA_URL=http://192.168.1.20:11434

# Example local tags: choose installed quantized models that fit each node's RAM.
# NODE1_OLLAMA_MODEL / NODE2_OLLAMA_MODEL are also accepted as legacy aliases.
NODE1_MODEL=qwen2.5:7b
NODE2_MODEL=llama3.2:3b
# Four threads per node suit the baseline four-core CPUs; adjust for your hardware.
NODE1_OLLAMA_NUM_THREADS=4
NODE2_OLLAMA_NUM_THREADS=4

# Resolved relative to the repository root; created when Phase 2 storage opens.
DATABASE_PATH=data/dynagraph.db
SQLITE_WAL_MODE=true
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_POOL_SIZE=4

# Seconds. Inference allows CPU execution and cold model loading.
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_HEALTH_TIMEOUT_SECONDS=10
OLLAMA_INFERENCE_TIMEOUT_SECONDS=300

# Phase 4: JSON array of relations with exactly one current object per subject.
# Example only: SINGLE_VALUED_PREDICATES='["primary_database", "status"]'
# No relationship is assumed single-valued until you configure it.
SINGLE_VALUED_PREDICATES='[]'
PRUNING_THRESHOLD=0.2
PRUNING_BATCH_SIZE=100
PRUNING_INTERVAL_SECONDS=60
DECAY_RECENCY_HALF_LIFE_SECONDS=86400
DECAY_TURN_HALF_LIFE=10
